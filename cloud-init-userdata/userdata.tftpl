#cloud-config
%{ if hostname != "" }hostname: ${hostname}
fqdn: ${hostname}.lan%{ endif }
manage_etc_hosts: false

user: ${username}
%{ if ssh_key != "" }ssh_authorized_keys:
  - ${ssh_key}%{ endif }
%{ if ssh_import_id != "" }ssh_import_id:
  - ${ssh_import_id}%{ endif }
%{ if password != "" }password: ${password}
chpasswd:
  expire: false
%{ endif }
%{ if ssh_pwauth != "" }ssh_pwauth: ${ssh_pwauth}%{ endif }

package_upgrade: true
package_reboot_if_required: true
packages:
  - qemu-guest-agent
%{ if length(additional_packages) != 0 }  - ${join("\n  - ", additional_packages)}%{ endif }
runcmd:
  - - systemctl
    - enable
    - --now
    - qemu-guest-agent.service
%{ if apt_mirror != "" }apt:
  primary:
    - arches: [default]
      uri: ${apt_mirror}%{ endif }
